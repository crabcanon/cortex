{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "citations", "confidence", "missing_evidence"],
  "properties": {
    "answer": {
      "type": "string",
      "description": "Concise answer grounded in the supplied context."
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Short source labels, URLs, or object IDs used as evidence."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
