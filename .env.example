# App
CORTEX_ENV=local
CORTEX_HOST=127.0.0.1
CORTEX_PORT=8080

# Database
# Use SQLite for the lightest local start, or switch to the Docker Postgres DSN below.
CORTEX_DB_DSN=sqlite+aiosqlite:///./.data/cortex.db
# CORTEX_DB_DSN=postgresql+asyncpg://cortex:cortex@127.0.0.1:5432/cortex

# Object storage
CORTEX_S3_ENDPOINT=http://127.0.0.1:9000
# Optional public object-storage endpoint used when Cortex returns presigned upload/download URLs.
# Set this when the API reaches storage through an internal network name (for example `http://minio:9000`)
# but callers must use a host-visible endpoint (for example `http://127.0.0.1:9000`).
CORTEX_S3_PUBLIC_ENDPOINT=
CORTEX_S3_REGION=us-east-1
CORTEX_S3_BUCKET=cortex-local
CORTEX_S3_ACCESS_KEY=minioadmin
CORTEX_S3_SECRET_KEY=minioadmin
CORTEX_S3_FORCE_PATH_STYLE=true
CORTEX_S3_AUTO_CREATE_BUCKET=true
CORTEX_S3_UPLOAD_URL_TTL_SECONDS=3600
CORTEX_S3_DOWNLOAD_MAX_TTL_SECONDS=86400
CORTEX_S3_MULTIPART_THRESHOLD_BYTES=16777216
CORTEX_S3_DEFAULT_PART_SIZE_BYTES=8388608
CORTEX_STORAGE_DIRECT_UPLOAD_MAX_BYTES=52428800

# Queue
CORTEX_QUEUE_URL=redis://127.0.0.1:6379/0

# Auth
CORTEX_AUTH_MODE=dev
CORTEX_OIDC_ISSUER=https://auth.cortex.local
CORTEX_OIDC_AUDIENCE=cortex-api
CORTEX_AUTH_JWT_ALGORITHM=HS256
CORTEX_AUTH_JWT_SHARED_SECRET=cortex-dev-shared-secret
CORTEX_AUTH_JWKS_URL=
CORTEX_AUTH_INTROSPECTION_URL=
CORTEX_AUTH_INTROSPECTION_CLIENT_ID=
CORTEX_AUTH_INTROSPECTION_CLIENT_SECRET=
CORTEX_AUTH_CLOCK_SKEW_SECONDS=30
CORTEX_AUTH_AUTO_PROVISION_PRINCIPALS=true

# Unified runtime config
CORTEX_RUNTIME_CONFIG_PATH=configs/cortex.runtime.local.yaml

# Crawl4AI / Playwright runtime
CORTEX_CRAWL4AI_INSTALL_IF_MISSING=0
CORTEX_CRAWL4AI_WITH_DEPS=0
CORTEX_CRAWL4AI_SKIP_PROBE=0
CORTEX_PLAYWRIGHT_BROWSERS_PATH=
CORTEX_CRAWL4AI_BASE_DIRECTORY=
CORTEX_CRAWL4AI_PROXY=

# Optional Docker build image overrides for local/CI mirrors
CORTEX_PYTHON_BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim
CORTEX_UV_IMAGE=ghcr.io/astral-sh/uv:0.7.22
CORTEX_PLAYWRIGHT_PYTHON_BASE_IMAGE=mcr.microsoft.com/playwright/python:v1.58.0-noble

# Optional parser provider secrets.
JINA_API_KEY=
LLAMA_CLOUD_API_KEY=

# Model provider slots.
# Keep provider base URL, API key, and model IDs here; runtime YAML decides which
# API family references which slot. Current LLM-backed adapters expect
# OpenAI-compatible REST endpoints.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL_ID=gemini/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL_ID=qwen-plus
QWEN_EMBEDDING_MODEL_ID=text-embedding-v3
QWEN_EMBEDDING_DIMENSIONS=1024

KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL_ID=kimi-k2.6
KIMI_EMBEDDING_MODEL_ID=
KIMI_EMBEDDING_DIMENSIONS=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=openrouter/auto
OPENROUTER_EMBEDDING_MODEL_ID=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL_ID=llama3.1:8b
OLLAMA_EMBEDDING_MODEL_ID=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768

LOCAL_LLM_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_LLM_API_KEY=local-dev-key
LOCAL_LLM_MODEL_ID=
LOCAL_EMBEDDING_MODEL_ID=
LOCAL_EMBEDDING_DIMENSIONS=

# Optional outbound proxy for containers. Useful when a provider such as Kimi
# is reachable from the host but blocked from Docker containers without proxy.
# For host-side proxy tools on Docker Desktop, prefer host.docker.internal.
# Example: HTTPS_PROXY=http://host.docker.internal:7890
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,minio,otel-collector,prometheus,grafana,jaeger-all-in-one,cortex-api

# Worker lease/heartbeat controls. Increase these when model-backed jobs take
# longer than one minute, or a job can be recovered as stale while still running.
CORTEX_KNOWLEDGE_WORKER_LEASE_SECONDS=300
CORTEX_KNOWLEDGE_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
CORTEX_EVALUATION_WORKER_LEASE_SECONDS=300
CORTEX_EVALUATION_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
CORTEX_SYNTHESIS_WORKER_LEASE_SECONDS=300
CORTEX_SYNTHESIS_WORKER_HEARTBEAT_INTERVAL_SECONDS=30

COGNEE_VECTOR_DB_URL=
COGNEE_GRAPH_DB_URL=
COGNEE_GRAPH_DB_USERNAME=
COGNEE_GRAPH_DB_PASSWORD=
COGNEE_RELATIONAL_DB_URL=
COGNEE_MIGRATION_DB_URL=

# Observability
CORTEX_OTEL_ENABLED=true
CORTEX_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
CORTEX_DEPLOYMENT_ENV=local
CORTEX_REGION=local
CORTEX_CLUSTER=devbox
