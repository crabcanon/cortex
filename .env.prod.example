# Core runtime
CORTEX_ENV=prod
CORTEX_HOST=0.0.0.0
CORTEX_PORT=8080
CORTEX_RUNTIME_CONFIG_PATH=configs/cortex.runtime.prod.yaml
CORTEX_CRAWL4AI_INSTALL_IF_MISSING=0
CORTEX_CRAWL4AI_WITH_DEPS=0
CORTEX_CRAWL4AI_SKIP_PROBE=0
CORTEX_PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
CORTEX_CRAWL4AI_BASE_DIRECTORY=

# Published images
CORTEX_API_IMAGE=ghcr.io/crabcanon/cortex-api:latest
CORTEX_PARSE_WORKER_IMAGE=ghcr.io/crabcanon/cortex-parse-worker:latest
CORTEX_PARSE_WORKER_DOCLING_IMAGE=ghcr.io/crabcanon/cortex-parse-worker-docling:latest
CORTEX_KNOWLEDGE_WORKER_IMAGE=ghcr.io/crabcanon/cortex-knowledge-worker:latest
CORTEX_EVALUATION_WORKER_IMAGE=ghcr.io/crabcanon/cortex-evaluation-worker:latest
CORTEX_EVALUATION_WORKER_RUNTIME_IMAGE=ghcr.io/crabcanon/cortex-evaluation-worker-runtime:latest
CORTEX_SYNTHESIS_WORKER_IMAGE=ghcr.io/crabcanon/cortex-synthesis-worker:latest
CORTEX_SYNTHESIS_WORKER_RUNTIME_IMAGE=ghcr.io/crabcanon/cortex-synthesis-worker-runtime:latest
CORTEX_API_PUBLISHED_PORT=8080

# Optional build-time base image overrides for CI mirrors
CORTEX_PYTHON_BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim
CORTEX_UV_IMAGE=ghcr.io/astral-sh/uv:0.7.22
CORTEX_PLAYWRIGHT_PYTHON_BASE_IMAGE=mcr.microsoft.com/playwright/python:v1.58.0-noble

# Database / queue / object storage
CORTEX_DB_DSN=postgresql+asyncpg://cortex:<password>@postgres.example.com:5432/cortex
CORTEX_QUEUE_URL=redis://redis.example.com:6379/0
CORTEX_S3_ENDPOINT=https://s3.example.com
CORTEX_S3_PUBLIC_ENDPOINT=
CORTEX_S3_REGION=us-east-1
CORTEX_S3_BUCKET=cortex-prod
CORTEX_S3_ACCESS_KEY=<replace-me>
CORTEX_S3_SECRET_KEY=<replace-me>
CORTEX_S3_FORCE_PATH_STYLE=false
CORTEX_S3_AUTO_CREATE_BUCKET=false
CORTEX_STORAGE_DIRECT_UPLOAD_MAX_BYTES=52428800

# Auth
CORTEX_AUTH_MODE=oidc
CORTEX_OIDC_ISSUER=https://auth.example.com
CORTEX_OIDC_AUDIENCE=cortex-api
CORTEX_AUTH_JWT_ALGORITHM=RS256
CORTEX_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
CORTEX_AUTH_AUTO_PROVISION_PRINCIPALS=false

# Observability
CORTEX_OTEL_ENABLED=true
CORTEX_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.example.com:4318
CORTEX_DEPLOYMENT_ENV=prod
CORTEX_REGION=cn-shanghai
CORTEX_CLUSTER=cortex-prod

# Parse providers
CORTEX_CRAWL4AI_PROXY=
JINA_API_KEY=
LLAMA_CLOUD_API_KEY=

# Model provider slots.
# Keep provider base URL, API key, and model IDs here; runtime YAML decides which
# API family references which slot. Current LLM-backed adapters expect
# OpenAI-compatible REST endpoints.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL_ID=gemini/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL_ID=qwen-plus
QWEN_EMBEDDING_MODEL_ID=text-embedding-v3
QWEN_EMBEDDING_DIMENSIONS=1024

KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL_ID=kimi-k2.6
KIMI_EMBEDDING_MODEL_ID=
KIMI_EMBEDDING_DIMENSIONS=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=openrouter/auto
OPENROUTER_EMBEDDING_MODEL_ID=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL_ID=llama3.1:8b
OLLAMA_EMBEDDING_MODEL_ID=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768

LOCAL_LLM_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_LLM_API_KEY=local-dev-key
LOCAL_LLM_MODEL_ID=
LOCAL_EMBEDDING_MODEL_ID=
LOCAL_EMBEDDING_DIMENSIONS=

HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,minio,otel-collector,prometheus,grafana,jaeger-all-in-one,cortex-api

CORTEX_KNOWLEDGE_WORKER_LEASE_SECONDS=300
CORTEX_KNOWLEDGE_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
CORTEX_EVALUATION_WORKER_LEASE_SECONDS=300
CORTEX_EVALUATION_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
CORTEX_SYNTHESIS_WORKER_LEASE_SECONDS=300
CORTEX_SYNTHESIS_WORKER_HEARTBEAT_INTERVAL_SECONDS=30

COGNEE_VECTOR_DB_URL=
COGNEE_GRAPH_DB_URL=
COGNEE_GRAPH_DB_USERNAME=
COGNEE_GRAPH_DB_PASSWORD=
COGNEE_RELATIONAL_DB_URL=
COGNEE_MIGRATION_DB_URL=
