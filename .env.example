# App
CORTEX_ENV=local
CORTEX_HOST=127.0.0.1
CORTEX_PORT=8080

# Database
CORTEX_DB_DSN=sqlite+aiosqlite:///./.data/cortex.db

# Object storage
CORTEX_S3_ENDPOINT=http://127.0.0.1:9000
CORTEX_S3_REGION=us-east-1
CORTEX_S3_BUCKET=cortex-local
CORTEX_S3_ACCESS_KEY=minioadmin
CORTEX_S3_SECRET_KEY=minioadmin
CORTEX_S3_FORCE_PATH_STYLE=true
CORTEX_S3_AUTO_CREATE_BUCKET=true
CORTEX_S3_UPLOAD_URL_TTL_SECONDS=3600
CORTEX_S3_DOWNLOAD_MAX_TTL_SECONDS=86400
CORTEX_S3_MULTIPART_THRESHOLD_BYTES=16777216
CORTEX_S3_DEFAULT_PART_SIZE_BYTES=8388608

# Queue
CORTEX_QUEUE_URL=redis://127.0.0.1:6379/0

# Auth
CORTEX_AUTH_MODE=dev
CORTEX_OIDC_ISSUER=https://auth.cortex.local
CORTEX_OIDC_AUDIENCE=cortex-api
CORTEX_AUTH_JWT_ALGORITHM=HS256
CORTEX_AUTH_JWT_SHARED_SECRET=cortex-dev-shared-secret
CORTEX_AUTH_JWKS_URL=
CORTEX_AUTH_INTROSPECTION_URL=
CORTEX_AUTH_INTROSPECTION_CLIENT_ID=
CORTEX_AUTH_INTROSPECTION_CLIENT_SECRET=
CORTEX_AUTH_CLOCK_SKEW_SECONDS=30
CORTEX_AUTH_AUTO_PROVISION_PRINCIPALS=true
CORTEX_AUTH_TOKEN_ISSUER_ENABLED=false
CORTEX_AUTH_TOKEN_ISSUER_BOOTSTRAP_SECRET=
CORTEX_AUTH_TOKEN_DEFAULT_TTL_SECONDS=3600
CORTEX_AUTH_TOKEN_MAX_TTL_SECONDS=86400

# Unified runtime config
# Switch to staging/prod by pointing this to the corresponding file in configs/
CORTEX_RUNTIME_CONFIG_PATH=configs/cortex.runtime.local.yaml

# Optional provider secrets referenced by the runtime config files
CORTEX_CRAWL4AI_PROXY=
JINA_API_KEY=
LLAMA_CLOUD_API_KEY=
OPENAI_API_KEY=
COGNEE_VECTOR_DB_URL=
COGNEE_GRAPH_DB_URL=
COGNEE_GRAPH_DB_USERNAME=
COGNEE_GRAPH_DB_PASSWORD=
COGNEE_RELATIONAL_DB_URL=
COGNEE_MIGRATION_DB_URL=

# Observability
CORTEX_OTEL_ENABLED=true
CORTEX_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
CORTEX_DEPLOYMENT_ENV=local
CORTEX_REGION=local
CORTEX_CLUSTER=devbox
