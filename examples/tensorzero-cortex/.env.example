# Cortex API, assumed to be started by the repository Docker stack.
CORTEX_BASE_URL=http://127.0.0.1:8080
CORTEX_BEARER_TOKEN=
CORTEX_TENANT_ID=tenant_demo
CORTEX_ACTOR_ID=tensorzero-cortex-demo

# TensorZero Gateway.
TENSORZERO_GATEWAY_HOST_PORT=3002
TENSORZERO_GATEWAY_URL=http://127.0.0.1:3002
TENSORZERO_UI_URL=http://127.0.0.1:4000
# Full experiment readiness budget. The diagnostic /tensorzero/status endpoint uses a short check.
TENSORZERO_READY_TIMEOUT_SECONDS=180

# Model provider slots used by tensorzero/tensorzero.toml.tpl.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4.1-mini

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL_ID=kimi-k2-0905-preview

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=openrouter/auto
OPENROUTER_EMBEDDING_MODEL_ID=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL_ID=llama3.1:8b
OLLAMA_EMBEDDING_MODEL_ID=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768

# Optional outbound proxy for TensorZero Gateway when provider endpoints are
# reachable from the host but blocked from Docker containers.
# For host-side proxy tools on Docker Desktop, prefer host.docker.internal.
# Example: HTTPS_PROXY=http://host.docker.internal:7890
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,clickhouse,postgres,gateway,ui

# Experiment knobs.
PARSE_ENGINES=auto,crawl4ai,jina_reader,markitdown,llama_parse,docling

# sync: call /v1/parse/sync; async: submit /v1/parse/jobs and read job results.
# The example always routes docling through async jobs unless you override parse.engine_modes.
PARSE_MODE=sync

DEFAULT_QUERY=What are the key macroeconomic and financial stability risks mentioned in the documents?
MAX_URLS=5
KNOWLEDGE_SEARCH_TYPE=CHUNKS
# Render Cognee graph visualization HTML into artifacts/{run_id}/knowledge_graph.html
# after Knowledge Add/Cognify succeeds. Requires the Docker knowledge worker container.
KNOWLEDGE_GRAPH_VISUALIZATION=true
CORTEX_KNOWLEDGE_WORKER_CONTAINER=cortex-local-cortex-knowledge-worker-1

# Keep this false for parse/storage/knowledge-only runs.
# Set true to submit the generated RAG evaluation dataset to Cortex Evaluation.
SUBMIT_CORTEX_EVAL=false

# sync: call /v1/eval/sync; async: submit /v1/eval/jobs and read job results.
CORTEX_EVAL_MODE=sync
CORTEX_EVAL_TYPES=rag,custom
CORTEX_EVAL_METRIC_PROFILE=deepeval_rag_core

# TensorZero orchestration.
# exhaustive: pin every configured variant for every context group.
# adaptive: let TensorZero Gateway sample one variant and optimize from feedback.
# selected: pin only the first configured variant.
TENSORZERO_STRATEGY=exhaustive
TENSORZERO_VARIANTS=openai,gemini,kimi
TENSORZERO_CONTEXT_GROUPING=by_parse_engine
TENSORZERO_MAX_CONTEXT_CHARS_PER_GROUP=12000

# TensorZero local infrastructure.
TENSORZERO_CLICKHOUSE_URL=http://chuser:chpassword@clickhouse:8123/tensorzero

# TensorZero adaptive A/B tests require Postgres with pg_cron. Keep a dedicated
# TensorZero Postgres on host port 5434 so it does not conflict with Cortex 5432.
TENSORZERO_POSTGRES_IMAGE_TAG=17
TENSORZERO_POSTGRES_HOST_PORT=5434
TENSORZERO_POSTGRES_USER=postgres
TENSORZERO_POSTGRES_PASSWORD=postgres
TENSORZERO_POSTGRES_DB=tensorzero
TENSORZERO_POSTGRES_URL=postgres://postgres:postgres@postgres:5432/tensorzero
